# Skopiuj jako .env (jest w .gitignore).

# Ten sam token musi trafic do secrets.properties aplikacji jako TELEMETRY_TOKEN.
# Wygeneruj czyms losowym, na przyklad:  openssl rand -hex 32
TELEMETRY_TOKEN=

# Tylko gdy chcesz tunel w kontenerze (docker compose --profile tunnel up -d).
# Masz juz cloudflared na hoscie? Zostaw puste i skieruj go na 127.0.0.1:8000.
TUNNEL_TOKEN=
