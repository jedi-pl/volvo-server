# Skopiuj jako .env (jest w .gitignore).

# ---------------------------------------------------------------------------
# TY go wymyslasz. Chroni API nagran - bez niego kazdy, kto zna adres,
# moglby czytac i dopisywac dane.
#
#   openssl rand -hex 32
#
# Ten SAM ciag musi trafic do secrets.properties aplikacji jako TELEMETRY_TOKEN,
# inaczej auto dostanie 401.
# ---------------------------------------------------------------------------
TELEMETRY_TOKEN=

# ---------------------------------------------------------------------------
# To NIE jest token, ktory wymyslasz - generuje go Cloudflare przy tworzeniu
# tunelu (Zero Trust -> Networks -> Tunnels -> Create a tunnel -> Docker).
#
# Potrzebny TYLKO wtedy, gdy chcesz uruchomic cloudflared jako kontener obok
# serwisu:   docker compose --profile tunnel up -d
#
# Masz juz cloudflared na hoscie? Zostaw to pole puste i nigdy nie uzywaj
# profilu `tunnel` - po prostu skieruj istniejacy tunel na 127.0.0.1:8988.
# ---------------------------------------------------------------------------
TUNNEL_TOKEN=

# Port na hoscie, gdyby 8988 bylo zajete. Tunelu to NIE dotyczy.
HOST_PORT=8988
